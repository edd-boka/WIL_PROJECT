@page
@model ProgressMonitoring.Api.Pages.Learners.AddModel
@{
    ViewData["Title"] = "Add Learner";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Add Learner</h2>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">Back to Learners</a>
</div>

@if (TempData["Message"] is string message)
{
<div class="alert alert-success">@message</div>
}

@if (!ModelState.IsValid)
{
<div class="alert alert-danger">
    <ul class="mb-0">
        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
        {
        <li>@error.ErrorMessage</li>
        }
    </ul>
</div>
}

<div class="card shadow-sm" style="max-width: 560px;">
    <div class="card-body">
        <form method="post">
            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">First name</label>
                    <input asp-for="Input.FirstName" class="form-control" required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Last name</label>
                    <input asp-for="Input.LastName" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Grade</label>
                <select name="Input.Grade" class="form-select" required>
                    <option value="">-- choose --</option>
                    @foreach (var grade in Model.GradeOptions)
                    {
                    <option value="@grade" selected="@(grade == Model.Input.Grade)">@grade</option>
                    }
                </select>
                <div class="form-text">
                    Only the grades you teach are listed. The learner is automatically in every subject taught to that grade.
                </div>
            </div>

            @if (User.IsInRole("admin"))
            {
                <div class="mb-3">
                    <label asp-for="Input.TeacherId" class="form-label">Assign teacher</label>
                    <select asp-for="Input.TeacherId" class="form-select" id="teacher-select" required>
                        <option value="">-- choose a teacher for this grade --</option>
                        @foreach (var teacher in Model.TeacherOptions)
                        {
                            <option value="@teacher.Id" data-grade="@teacher.Grade">@teacher.Name (Grade @teacher.Grade)</option>
                        }
                    </select>
                    <span asp-validation-for="Input.TeacherId" class="text-danger small"></span>
                    <div class="form-text">Only teachers assigned to the selected grade are available.</div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Parent / guardian email</label>
                <input asp-for="Input.ParentEmail" type="email" class="form-control" autocomplete="off" required />
                <div class="form-text">
                    The parent signs in to the parent app with this email and is linked to this learner straight away.
                    A parent with more than one child at school: use the same email for each child.
                </div>

                @if (User.IsInRole("admin"))
                {
                    @section Scripts {
                        <script>
                            const gradeSelect = document.querySelector('[name="Input.Grade"]');
                            const teacherSelect = document.getElementById('teacher-select');
                            const selectedTeacher = '@Model.Input.TeacherId';

                            function filterTeachers() {
                                const grade = gradeSelect.value;
                                for (const option of teacherSelect.options) {
                                    if (!option.value) continue;
                                    option.hidden = option.dataset.grade !== grade;
                                    option.disabled = option.hidden;
                                }
                                if (teacherSelect.selectedOptions.length &&
                                    (teacherSelect.selectedOptions[0].dataset.grade !== grade)) {
                                    teacherSelect.value = '';
                                }
                            }

                            if (selectedTeacher) teacherSelect.value = selectedTeacher;
                            gradeSelect.addEventListener('change', filterTeachers);
                            filterTeachers();
                        </script>
                    }
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Second parent / guardian email <span class="text-muted">(optional)</span></label>
                <input asp-for="Input.ParentEmail2" type="email" class="form-control" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary">Save learner</button>
            <button type="submit" name="addAnother" value="true" class="btn btn-outline-primary">Save and add another</button>
        </form>
    </div>
</div>
