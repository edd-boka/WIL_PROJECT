@page
@model ProgressMonitoring.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin overview";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">System administration</h1>
        <p class="text-muted mb-0">System-wide overview of accounts, school data, and activity.</p>
    </div>
    <span class="badge text-bg-primary fs-6">System administrator</span>
</div>

@if (TempData["AdminError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (TempData["AdminMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}
@if (Model.SupabaseSyncError is string syncError)
{
    <div class="alert alert-warning" role="alert">@syncError</div>
}
else if (Model.ImportedSupabaseUsers > 0)
{
    <div class="alert alert-info" role="status">@Model.ImportedSupabaseUsers mobile-app parent account(s) imported from Supabase Auth.</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">User accounts</div><div class="display-6">@Model.UserCount</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Teachers</div><div class="display-6">@Model.TeacherCount</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Parents / guardians</div><div class="display-6">@Model.ParentCount</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Learners</div><div class="display-6">@Model.LearnerCount</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Subjects</div><div class="display-6">@Model.SubjectCount</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Assessments</div><div class="display-6">@Model.AssessmentCount</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Marks recorded</div><div class="display-6">@Model.MarkCount</div></div></div></div>
</div>

<section class="card mb-4">
    <div class="card-header bg-white"><h2 class="h5 mb-0">User accounts</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Email</th><th>Role</th></tr></thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr><td colspan="2" class="text-muted">No user accounts found.</td></tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr><td>@user.Email</td><td><span class="badge text-bg-secondary">@user.Role</span></td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card mb-4">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Teachers</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Name</th><th>Staff ID</th><th>Email</th><th>Learners</th><th>Subject / grade assignments</th></tr></thead>
            <tbody>
                @if (Model.Teachers.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">No teacher profiles found.</td></tr>
                }
                @foreach (var teacher in Model.Teachers)
                {
                    <tr><td>@teacher.Name</td><td><code>@teacher.StaffId</code></td><td>@teacher.Email</td><td>@teacher.LearnerCount</td><td>@teacher.ClassCount</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card mb-4">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Parents and guardians</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Email verified</th><th>Linked learners</th></tr></thead>
            <tbody>
                @if (Model.Parents.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">No parent profiles found.</td></tr>
                }
                @foreach (var parent in Model.Parents)
                {
                    <tr><td>@parent.Name</td><td>@parent.Email</td><td>@(parent.EmailVerified ? "Yes" : "No")</td><td>@parent.LearnerCount</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card mb-4">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Learners</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Name</th><th>Grade</th><th>Teacher</th><th>Linked parents</th><th>Subjects</th></tr></thead>
            <tbody>
                @if (Model.Learners.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">No learners found.</td></tr>
                }
                @foreach (var learner in Model.Learners)
                {
                    <tr><td>@learner.Name</td><td>@learner.Grade</td><td>@learner.TeacherName</td><td>@learner.ParentCount</td><td>@learner.SubjectCount</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card mb-4">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Subjects</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Subject</th><th>Phase</th><th>Teacher assignments</th><th>Learner enrollments</th><th>Assessments</th></tr></thead>
            <tbody>
                @if (Model.Subjects.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">No subjects found.</td></tr>
                }
                @foreach (var subject in Model.Subjects)
                {
                    <tr><td>@subject.Name</td><td>@subject.Phase</td><td>@subject.TeacherAssignments</td><td>@subject.LearnerEnrollments</td><td>@subject.Assessments</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card mb-4">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Guardian emails on learner records</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Learner</th><th>Guardian email</th><th>Alternate Guardian email</th><th>Action</th></tr></thead>
            <tbody>
                @if (Model.GuardianEmails.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">No learners found.</td></tr>
                }
                @foreach (var guardianEmail in Model.GuardianEmails)
                {
                    <tr>
                        <td>@guardianEmail.LearnerName</td>
                        <td colspan="3">
                            <form method="post" asp-page-handler="UpdateGuardianEmails" class="row g-2 align-items-center">
                                <input type="hidden" name="learnerId" value="@guardianEmail.LearnerId" />
                                <div class="col-md-4">
                                    <label class="visually-hidden" for="guardian-@guardianEmail.LearnerId">Guardian email</label>
                                    <input id="guardian-@guardianEmail.LearnerId" name="guardianEmail" type="email" maxlength="200" class="form-control form-control-sm" value="@guardianEmail.GuardianEmail" placeholder="Guardian email" />
                                </div>
                                <div class="col-md-4">
                                    <label class="visually-hidden" for="alternate-guardian-@guardianEmail.LearnerId">Alternate Guardian email</label>
                                    <input id="alternate-guardian-@guardianEmail.LearnerId" name="alternateGuardianEmail" type="email" maxlength="200" class="form-control form-control-sm" value="@guardianEmail.AlternateGuardianEmail" placeholder="Alternate Guardian email" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Recent assessments</h2></div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Assessment</th><th>Subject</th><th>Grade</th><th>Teacher</th><th>Date</th></tr></thead>
            <tbody>
                @if (Model.RecentAssessments.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">No assessments found.</td></tr>
                }
                @foreach (var assessment in Model.RecentAssessments)
                {
                    <tr><td>@assessment.Title</td><td>@assessment.SubjectName</td><td>@assessment.Grade</td><td>@assessment.TeacherName</td><td>@assessment.Date.ToString("dd MMM yyyy")</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
