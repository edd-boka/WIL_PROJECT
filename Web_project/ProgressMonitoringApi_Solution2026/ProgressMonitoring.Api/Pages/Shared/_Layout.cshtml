@{
    var logo = "data:image/png;base64,";
    var page = (ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty);
    string Active(params string[] prefixes) =>
        prefixes.Any(p => page.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty;
    var initial = email.Length > 0 ? email.Substring(0, 1).ToUpper() : "T";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EduTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
/* EduTracker theme - light blue. Loaded after Bootstrap, so it restyles every page. */
:root {
  --et-blue: #5db2f6;        /* main light blue */
  --et-blue-hover: #4aa5ee;
  --et-blue-mid: #d4eafd;
  --et-blue-soft: #e8f4fe;
  --et-link: #1f78c2;        /* blue used for text on white */
  --et-on-blue: #17222d;     /* text on light-blue buttons */
  --et-ink: #26323f;
  --et-muted: #5f6b7a;
  --et-page: #f6fafe;
  --et-line: #dcebf9;
  --et-sun: #ff9a52;         /* orange from the logo */

  /* Make Bootstrap's "primary" the light blue everywhere */
  --bs-primary: #5db2f6;
  --bs-primary-rgb: 93, 178, 246;
  --bs-link-color: #1f78c2;
  --bs-link-color-rgb: 31, 120, 194;
  --bs-link-hover-color: #165f9c;
  --bs-body-color: #26323f;
  --bs-body-bg: #f6fafe;
  --bs-border-color: #dcebf9;
}
body { font-family: "Nunito Sans", system-ui, sans-serif; color: var(--et-ink); background: var(--et-page); }
h1, h2, h3, h4, h5 { font-family: Montserrat, system-ui, sans-serif; font-weight: 700; color: var(--et-ink); }
.text-muted { color: var(--et-muted) !important; }
.bg-light { background: var(--et-page) !important; }

/* ---- Bootstrap components in light blue ---- */
.btn-primary {
  --bs-btn-color: var(--et-on-blue); --bs-btn-bg: var(--et-blue); --bs-btn-border-color: var(--et-blue);
  --bs-btn-hover-color: var(--et-on-blue); --bs-btn-hover-bg: var(--et-blue-hover); --bs-btn-hover-border-color: var(--et-blue-hover);
  --bs-btn-active-color: var(--et-on-blue); --bs-btn-active-bg: var(--et-blue-hover); --bs-btn-active-border-color: var(--et-blue-hover);
  --bs-btn-disabled-color: var(--et-on-blue); --bs-btn-disabled-bg: var(--et-blue); --bs-btn-disabled-border-color: var(--et-blue);
  --bs-btn-focus-shadow-rgb: 93, 178, 246; font-weight: 700;
}
.btn-outline-primary {
  --bs-btn-color: var(--et-link); --bs-btn-border-color: var(--et-blue);
  --bs-btn-hover-color: var(--et-on-blue); --bs-btn-hover-bg: var(--et-blue); --bs-btn-hover-border-color: var(--et-blue);
  --bs-btn-active-color: var(--et-on-blue); --bs-btn-active-bg: var(--et-blue); --bs-btn-active-border-color: var(--et-blue);
}
.badge.bg-primary { color: var(--et-on-blue) !important; }
.text-primary { color: var(--et-link) !important; }
.bg-primary-subtle, .table-primary { background: var(--et-blue-soft) !important; }
.form-control:focus, .form-select:focus { border-color: var(--et-blue); box-shadow: 0 0 0 .2rem rgba(93,178,246,.3); }
.form-check-input:checked { background-color: var(--et-blue); border-color: var(--et-blue); }
.form-check-input:focus { border-color: var(--et-blue); box-shadow: 0 0 0 .2rem rgba(93,178,246,.3); }
.nav-tabs { border-bottom-color: var(--et-line); }
.nav-tabs .nav-link { color: var(--et-muted); font-weight: 700; }
.nav-tabs .nav-link:hover { color: var(--et-link); }
.nav-tabs .nav-link.active { color: var(--et-link); background: #fff; border-color: var(--et-line) var(--et-line) #fff; border-top: 3px solid var(--et-blue); }
.card { border-color: var(--et-line); border-radius: 14px; }
.card.shadow-sm { box-shadow: 0 2px 10px rgba(93,178,246,.14) !important; }
.table > :not(caption) > * > * { border-color: var(--et-line); }
.table thead th { color: var(--et-muted); font-size: .85rem; }
:focus-visible { outline: 3px solid var(--et-sun); outline-offset: 2px; }

/* ---- App shell: sidebar ---- */
.et-app { display: grid; grid-template-columns: 250px minmax(0, 1fr); min-height: 100vh; }
.et-side { background: #fff; border-right: 1px solid var(--et-line); display: flex; flex-direction: column; padding: 22px 16px; position: sticky; top: 0; height: 100vh; }
.et-brand { display: block; padding: 0 6px 18px; margin-bottom: 18px; border-bottom: 3px solid var(--et-sun); }
.et-brand img { display: block; width: 150px; height: auto; margin: 0 auto; }
.et-nav { display: flex; flex-direction: column; gap: 4px; }
.et-nav a { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 10px; font-weight: 700; color: var(--et-muted); text-decoration: none; position: relative; }
.et-nav a:hover { background: var(--et-blue-soft); color: var(--et-link); }
.et-nav a.active { background: var(--et-blue-mid); color: var(--et-link); }
.et-nav a.active::before { content: ""; position: absolute; left: -16px; top: 8px; bottom: 8px; width: 5px; border-radius: 0 4px 4px 0; background: var(--et-sun); }
.et-nav svg, .et-tile svg { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.et-me { margin-top: auto; border-top: 1px solid var(--et-line); padding-top: 14px; display: flex; align-items: center; gap: 10px; }
.et-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--et-blue); color: var(--et-on-blue); display: grid; place-items: center; font: 700 14px Montserrat, sans-serif; flex: none; }
.et-me-text { min-width: 0; flex: 1; font-size: 13px; line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--et-muted); }
.et-main { padding: 26px 34px 48px; max-width: 1180px; width: 100%; }
.et-logout { all: unset; cursor: pointer; font-weight: 700; font-size: 14px; color: var(--et-link); }

/* login (signed-out) header */
.et-guest { text-align: center; padding-top: 28px; }
.et-guest img { width: 150px; height: auto; }

/* ---- Dashboard ---- */
.et-hero { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(120deg, #eef7ff, #cfe6fb); padding: 30px 32px; margin-bottom: 22px; }
.et-hero::after { content: ""; position: absolute; right: -90px; top: -150px; width: 420px; height: 420px; border-radius: 50%;
  background: repeating-conic-gradient(from 0deg, rgba(255,140,60,.7) 0 2deg, transparent 2deg 9deg);
  -webkit-mask: radial-gradient(circle, transparent 26%, #000 27%, transparent 70%); mask: radial-gradient(circle, transparent 26%, #000 27%, transparent 70%); }
.et-hero h1 { font-size: 30px; font-weight: 800; margin: 0; }
.et-hero p { margin: 8px 0 0; max-width: 46ch; color: var(--et-muted); }
.et-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 26px; }
.et-stat { background: #fff; border: 1px solid var(--et-line); border-left: 6px solid var(--et-blue); border-radius: 6px 16px 16px 6px; padding: 16px 20px; }
.et-stat:nth-child(2) { border-left-color: var(--et-sun); }
.et-stat b { display: block; font: 800 36px/1.1 Montserrat, sans-serif; }
.et-stat span { color: var(--et-muted); font-weight: 600; }
.et-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.et-tile { background: #fff; border: 1px solid var(--et-line); border-radius: 16px; padding: 22px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--et-ink); transition: border-color .15s, box-shadow .15s; }
.et-tile:hover { border-color: var(--et-blue); box-shadow: 0 8px 22px rgba(93,178,246,.25); color: var(--et-ink); }
.et-tile .ic { width: 48px; height: 48px; border-radius: 14px; background: var(--et-blue-mid); color: var(--et-link); display: grid; place-items: center; }
.et-tile:nth-child(2) .ic { background: #fff0e4; color: #d96a14; }
.et-tile strong { font: 700 18px Montserrat, sans-serif; }
.et-tile span { color: var(--et-muted); }

/* ---- Small screens: sidebar becomes a top bar ---- */
@@media (max-width: 900px) {
  .et-app { grid-template-columns: 1fr; }
  .et-side { position: static; height: auto; flex-direction: row; align-items: center; gap: 10px; padding: 10px 14px; overflow-x: auto; }
  .et-brand { border: 0; margin: 0; padding: 0; } .et-brand img { width: 64px; }
  .et-nav { flex-direction: row; } .et-nav a { padding: 9px 12px; white-space: nowrap; } .et-nav a.active::before { display: none; }
  .et-me { margin: 0 0 0 auto; border: 0; padding: 0; } .et-me-text { display: none; }
  .et-main { padding: 18px 16px 40px; }
  .et-tiles, .et-stats { grid-template-columns: 1fr; }
}
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="et-app">
            <aside class="et-side">
                <a class="et-brand" asp-page="/Index"><img src="@Html.Raw(logo)" alt="EduTracker" /></a>

                <nav class="et-nav" aria-label="Main">
                    <a class="@(page.Equals("/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Index">
                        <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>Dashboard</a>
                    <a class="@Active("/Learners")" asp-page="/Learners/index">
                        <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><path d="M16 5a3.2 3.2 0 010 6M18 14.8c2 .6 3.2 2.3 3.5 5.2"/></svg>Learners</a>
                    <a class="@Active("/Assessments", "/Marks")" asp-page="/Assessments/Index1">
                        <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>Assessments</a>
                    <a class="@Active("/Reports")" asp-page="/Reports/Index">
                        <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Reports</a>
                    <a class="@Active("/Teaching")" asp-page="/Teaching/Index">
                        <svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M7 9.5V15c0 1.4 2.2 3 5 3s5-1.6 5-3V9.5"/></svg>My Classes</a>
                </nav>

                <div class="et-me">
                    <div class="et-avatar">@initial</div>
                    <div class="et-me-text" title="@email">@email</div>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="et-logout">Log out</button>
                    </form>
                </div>
            </aside>

            <main class="et-main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container pb-5">
            <div class="et-guest"><img src="@Html.Raw(logo)" alt="EduTracker" /></div>
            @RenderBody()
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
